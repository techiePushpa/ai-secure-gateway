# The gateway works with zero keys (local template fallback), gets much
# better with just GROQ_API_KEY, and gets full functionality (text, vision,
# voice, image generation) with Groq + Hugging Face.

# --- Text chat (pick at least one; Groq is tried first) ---------------------
# Free, extremely fast (LPU inference). Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Free-tier models (model IDs ending in ":free"). Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. NOT free — requires a billed OpenAI account. Only add this if you
# specifically want GPT models as a third fallback.
OPENAI_API_KEY=

# --- Vision (image upload) + voice (transcription) + image generation ------
# Free "read" token, used for image generation (Stable Diffusion) and as a
# transcription fallback. Get one: https://huggingface.co/settings/tokens
HF_API_KEY=

