# Works with zero keys (local template fallback for text only), gets much
# better with GROQ_API_KEY, and gets full functionality (chat, coding,
# reasoning, vision, voice, OCR, image generation) with all three below.

# =========================
# GROQ  (free, very fast — get a key: https://console.groq.com/keys)
# =========================
GROQ_API_KEY=
CHAT_MODEL=llama-3.3-70b-versatile
CODING_MODEL=llama-3.3-70b-versatile

# =========================
# OPENROUTER  (free-tier ":free" models — get a key: https://openrouter.ai/keys)
# =========================
OPENROUTER_API_KEY=
REASONING_MODEL=deepseek/deepseek-r1:free
VISION_MODEL=qwen/qwen2.5-vl:free
FALLBACK_MODEL=openrouter/free

# =========================
# HUGGING FACE  (free "read" token — get one: https://huggingface.co/settings/tokens)
# =========================
HF_API_KEY=
STT_MODEL=openai/whisper-large-v3
OCR_MODEL=microsoft/trocr-base-printed
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
PROMPT_SHIELD_MODEL=ProtectAI/deberta-v3-base-prompt-injection-v2
TOXICITY_MODEL=unitary/toxic-bert
PII_MODEL=dslim/bert-base-NER

# =========================
# IMAGE GENERATION  (Hugging Face)
# =========================
IMAGE_MODEL=black-forest-labs/FLUX.1-dev

# =========================
# OPTIONAL — NOT free, requires a billed OpenAI account. Only add this if
# you specifically want GPT models as a third text fallback.
# =========================
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# =========================
# AUTH0  (get a free tenant: https://auth0.com — create a Single Page
# Application, NOT a third-party app; the Client ID should have no prefix)
# =========================
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Optional: only set this if you created a custom API under Applications >
# APIs in the Auth0 dashboard, and set the matching AUTH0_AUDIENCE const in
# nexora-app.html too. Leave blank to verify ID tokens instead — still a
# real, signature-verified JWT, just not scoped to a specific API.
AUTH0_AUDIENCE=
