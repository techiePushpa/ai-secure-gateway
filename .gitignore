# ============================================================
# Nexora — .gitignore
# ============================================================

# ---- Secrets — never commit these ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python (nexora-backend) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ---- Node (only relevant if/when the frontend moves to Next.js) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.turbo/

# ---- Databases (once PostgreSQL/SQLite persistence is added) ----
*.sqlite3
*.db
*.db-journal

# ---- Logs ----
*.log
logs/

# ---- OS files ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Misc build artifacts ----
*.zip
*.tar.gz
